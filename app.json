{
  "expo": {
    "name": "the-dented-puck-foundation",
    "slug": "dented-puck",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "thedentedpuckfoundation",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.thedentedpuckfoundation.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.thedentedpuckfoundation.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow The Dented Puck Foundation to take your profile photo.",
          "photosPermission": "Allow The Dented Puck Foundation to choose your profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow The Dented Puck Foundation to find teams and events near you."
        }
      ],
      "expo-asset",
      "expo-font",
      "@react-native-vector-icons/ionicons"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "39190b51-275d-4142-b9cc-a9c7dfc1f39b"
      }
    },
    "owner": "psangs"
  }
}
